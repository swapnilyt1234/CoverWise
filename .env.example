# Required by live startup; conversational intent parsing and diagnostic explanation.
# Offline commands/tests do not load .env. Populate locally; never commit values.
ASI1_API_KEY=

# CoverWise conventions, NOT SDK-required environment variable names.
# All three stable seeds are required and must be distinct. Preserve existing seeds.
COVERWISE_PERSONAL_AGENT_SEED=
COVERWISE_INVESTIGATOR_AGENT_SEED=
COVERWISE_PROVIDER_AGENT_SEED=

# Optional per-tool delegation deadline; range 0.05 to 30 seconds, default 15.
COVERWISE_REQUEST_TIMEOUT_SECONDS=15

# Optional persistent SQLite path. Omit to retain runtime/provider.sqlite3.
# For an isolated rehearsal only, set runtime/demo/rehearsal.sqlite3 in your shell.
# Do not replace an existing live database setting when checking old confirmations.
# COVERWISE_SANDBOX_DB=
